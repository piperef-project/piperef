{
  // Pipe Ref correction API + admin page.
  // api.piperef.site   -> public endpoints (submit, track, history)
  // admin.piperef.site -> admin page and admin endpoints, behind Cloudflare Access
  "name": "piperef-admin",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "piperef", "database_id": "2d5a3e57-7917-4d93-9e80-b26b77079cb8", "migrations_dir": "migrations" }
  ],
  "routes": [
    { "pattern": "api.piperef.site", "custom_domain": true },
    { "pattern": "admin.piperef.site", "custom_domain": true }
  ],
  "vars": {
    "SITE_ORIGINS": "https://piperef.net,https://www.piperef.net,https://piperef.site,https://www.piperef.site",
    "ACCESS_TEAM_DOMAIN": "piperef.cloudflareaccess.com",
    "ACCESS_AUD": "1fe17a34dac98d8ff70883b49ff0a9956f801906c6781dde5f78eff77f1e45c0",
    "ADMIN_HOST": "admin.piperef.site"
  },
  "observability": { "enabled": true }
}
